{
  "name": "pinchr",
  "version": "1.0.0",
  "description": "Pinchr — Mission Control for AI Assistants",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taw0002/pinchr"
  },
  "homepage": "https://pinchr.app",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:agent-skill": "mkdir -p .tmp-test && npx esbuild src/shared/agent-skill.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-test/agent-skill.test.cjs && node --test .tmp-test/agent-skill.test.cjs",
    "test:topic-router": "mkdir -p .tmp-test && npx esbuild src/main/topic-router.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-test/topic-router.test.cjs && node --test .tmp-test/topic-router.test.cjs",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "deploy": "bash deploy.sh",
    "dist:dmg": "electron-vite build && electron-builder --mac dmg --config electron-builder.yml",
    "release": "electron-vite build && electron-builder --mac --config electron-builder.yml && bash scripts/release-upload.sh",
    "release:upload": "bash scripts/release-upload.sh",
    "sign:verify": "codesign --verify --deep --strict dist/mac-arm64/Pinchr.app && /usr/sbin/spctl --assess --type exec --verbose dist/mac-arm64/Pinchr.app",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.60.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.7.3",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "node-pty": "^1.1.0",
    "openclaw": "^2026.2.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.2.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "postinstall-postinstall": "^2.1.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "ws": "^8.19.0"
  }
}
